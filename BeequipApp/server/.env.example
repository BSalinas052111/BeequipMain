# Copy this file to `.env` and adjust if needed.

# Connection string for MongoDB Community Edition running on your PC.
# We use 127.0.0.1 instead of `localhost` on purpose: `localhost` can resolve
# to IPv6 (::1), and MongoDB does not listen on IPv6 by default.
MONGODB_URI=mongodb://127.0.0.1:27017/beequip

# Port the API listens on. Keep this in sync with the app's EXPO_PUBLIC_API_URL.
PORT=3000
