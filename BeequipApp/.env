# Expo Router (SDK 56+) throws at bundle time when app code imports from
# @react-navigation/* while expo-router is installed:
#   "As of SDK 56, expo-router is no longer compatible with react-navigation."
# This app renders its own drawer/stack navigators (from the standalone
# @react-navigation packages) inside an expo-router route, so disable the
# bundler check. Official escape hatch:
# https://docs.expo.dev/router/migrate/sdk-55-to-56/
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1
